# 复制为 .env 后使用；.env 不入库
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# 可选：SQLite 文件路径，缺省为 <cwd>/data/ifss.sqlite
# DB_PATH=data/ifss.sqlite

# 世界沙盘 LLM。SANDBOX_LLM_PROVIDER=fake 时可不配下面两项（测试/CI 用）
# LLM_BASE_URL=https://api.openai-next.com/v1
# LLM_API_KEY=change-me
# SANDBOX_LLM_PROVIDER=openai
# SANDBOX_MODEL_ACT=claude-sonnet-5-5
# SANDBOX_MODEL_CAST=claude-opus-4-7-thinking
# SANDBOX_MAX_CALLS_PER_WORLD=120
# SANDBOX_MAX_CONCURRENCY=6
# SANDBOX_CACHE_ENABLED=true
# PACKS_DIR=<repoRoot>/packs
