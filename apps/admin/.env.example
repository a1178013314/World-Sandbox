# 复制为 .env 后使用；.env 不入库
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# 可选：SQLite 文件路径，缺省为 <cwd>/data/ifss.sqlite
# DB_PATH=data/ifss.sqlite

# 世界沙盘 LLM。SANDBOX_LLM_PROVIDER=fake 时可不配下面两项（测试/CI 用）
# LLM_BASE_URL=https://api.openai-next.com/v1
# LLM_API_KEY=change-me
# SANDBOX_LLM_PROVIDER=openai
# SANDBOX_MODEL_ACT=claude-sonnet-5-5
# SANDBOX_MODEL_CAST=claude-opus-4-7-thinking
# SANDBOX_MODEL_FORGE=claude-sonnet-5-5
# SANDBOX_MAX_CALLS_PER_WORLD=120
# SANDBOX_MAX_CONCURRENCY=6
# SANDBOX_CACHE_ENABLED=true
# PACKS_DIR=<repoRoot>/packs

# 一句话生成种子包：联网检索（anysearch，无需 key）
# SANDBOX_SEARCH_ENABLED=true
# SANDBOX_SEARCH_ENDPOINT=https://api.anysearch.com/v1/search
# SANDBOX_SEARCH_TIMEOUT_MS=9000
# SANDBOX_PERSIST_GENERATED_PACKS=true

# 角色发言朗读：走 OpenAI 兼容 /audio/speech，复用 LLM_BASE_URL / LLM_API_KEY
# SANDBOX_TTS_ENABLED=true
# SANDBOX_TTS_MODEL=qwen3-tts-flash
# SANDBOX_TTS_TIMEOUT_MS=20000
# SANDBOX_TTS_VOICES=Cherry,Serena,Ethan,Chelsie,Dylan,Ryan
