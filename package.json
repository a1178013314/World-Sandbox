{
  "name": "initial-framework-scaffolding-spec",
  "version": "0.1.0",
  "private": true,
  "description": "pnpm monorepo 初始骨架：NestJS admin + Vite React web + 共享 logger/shared 包",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:packages": "pnpm --filter @ifss/logger --filter @ifss/shared build",
    "typecheck": "pnpm run build:packages && pnpm -r typecheck",
    "test": "pnpm run build:packages && pnpm -r test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "pnpm run build:packages && pnpm -r --parallel dev",
    "dev:admin": "pnpm run build:packages && pnpm --filter @ifss/admin dev",
    "dev:web": "pnpm run build:packages && pnpm --filter @ifss/web dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@ifss/typescript-config": "workspace:*",
    "typescript": "^5.9.3"
  }
}
